             >%0A+                             Discard review%0A+                         </button>%0A+                         <button%0A+                             type="button"%0A+                             onClick={confirmReview}%0A+                             disabled={%0A+                                 isSaving%0A+                                 || !seed.sourceAvailable%0A+                                 || !prepared.value?.validation.valid%0A+                             }%0A+                             className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-bold text-white shadow-lg shadow-blue-500/20 transition-colors hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-50"%0A+                         >%0A+                             <CheckIcon className="h-4 w-4" />%0A+                             {isSaving%0A+                                 ? 'Saving graph…'%0A+                                 : 'Confirm report graph'}%0A+                         </button>%0A+                     </div>%0A+                 </footer>%0A+             </div>%0A+         </div>%0A+     );%0A+ };%0A+%0A+ export default DiagnosticReportReviewWorkspace;%0A+%0A%0A ❯ tests/diagnosticReportReviewWorkspace.test.ts:20:27%0A%0A
