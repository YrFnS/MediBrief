                                         <span className={labelClass}>Status</span>%0A+                                                         <select%0A+                                                             value={specimen.status || 'unknown'}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 {%0A+                                                                     status: event.target.value as ReviewedSpecimenDraft['status'],%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         >%0A+                                                             {SPECIMEN_STATUSES.map(status => (%0A+                                                                 <option key={status} value={status}>%0A+                                                                     {fieldLabel(status)}%0A+                                                                 </option>%0A+                                                             ))}%0A+                                                         </select>%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Identifier</span>%0A+                                                         <input%0A+                                                             value={specimen.identifiers?.[0]?.value || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 {%0A+                                                                     identifiers: optionalText(event.target.value)%0A+                                                                         ? [{%0A+                                                                             ...(specimen.identifiers?.[0] || {}),%0A+                                                                             value: event.target.value.trim(),%0A+                                                                         }]%0A+                                                                         : undefined,%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Collected date</span>%0A+                                                         <input%0A+                                                             value={specimen.collectedDate || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 {%0A+                                                                     collectedDate: nullableText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Received date</span>%0A+                                                         <input%0A+                                                             value={specimen.receivedDate || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 {%0A+                                                                     receivedDate: nullableText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Collector</span>%0A+                                                         <input%0A+                                                             value={specimen.collector || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 { collector: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Body site</span>%0A+                                                         <input%0A+                                                             value={specimen.bodySiteText || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 { bodySiteText: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Collection method</span>%0A+                                                         <input%0A+                                                             value={specimen.collectionMethodText || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 {%0A+                                                                     collectionMethodText: optionalText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label className="sm:col-span-2 lg:col-span-3">%0A+                                                         <span className={labelClass}>Notes</span>%0A+                                                         <input%0A+                                                             value={specimen.note || ''}%0A+                                                             onChange={event => updateSpecimen(%0A+                                                                 specimen.localId,%0A+                                                                 { note: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                 </div>%0A+                                             </article>%0A+                                         ))}%0A+                                     </div>%0A+                                 )}%0A+                             </section>%0A+%0A+                             <section className="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/60">%0A+                                 <div className="mb-3 flex items-center justify-between gap-3">%0A+                                     <div>%0A+                                         <h3 className="text-sm font-bold text-slate-900 dark:text-white">%0A+                                             Results%0A+                                         </h3>%0A+                                         <p className="mt-1 text-[10px] text-slate-500 dark:text-slate-400">%0A+                                             Include only rows confirmed against the original report. Qualitative, comparator, textual, and absent results are supported.%0A+                                         </p>%0A+                                     </div>%0A+                                     <button%0A+                                         type="button"%0A+                                         onClick={addResult}%0A+                                         className="rounded-lg border border-blue-200 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-blue-700 hover:bg-blue-50 dark:border-blue-900 dark:text-blue-300 dark:hover:bg-blue-950/30"%0A+                                     >%0A+                                         Add result%0A+                                     </button>%0A+                                 </div>%0A+                                 <div className="space-y-3">%0A+                                     {draft.results.map((result, index) => {%0A+                                         const included = includedResultIds.has(result.localId);%0A+                                         const pageNumber = result.source?.pageNumber;%0A+                                         return (%0A+                                             <article%0A+                                                 key={result.localId}%0A+                                                 className={`rounded-xl border p-3 transition-colors ${included%0A+                                                     ? 'border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-950/40'%0A+                                                     : 'border-slate-200 bg-slate-100 opacity-70 dark:border-slate-800 dark:bg-slate-950/20'%0A+                                                 }`}%0A+                                             >%0A+                                                 <div className="mb-3 flex flex-wrap items-center justify-between gap-3">%0A+                                                     <label className="flex cursor-pointer items-center gap-2">%0A+                                                         <input%0A+                                                             type="checkbox"%0A+                                                             checked={included}%0A+                                                             onChange={() => toggleResult(result.localId)}%0A+                                                         />%0A+                                                         <span className="text-xs font-bold text-slate-800 dark:text-slate-100">%0A+                                                             Result {index + 1}: {result.testName || 'Untitled'}%0A+                                                         </span>%0A+                                                     </label>%0A+                                                     <div className="flex items-center gap-2">%0A+                                                         {pageNumber && (%0A+                                                             <button%0A+                                                                 type="button"%0A+                                                                 onClick={() => setSourcePage(pageNumber)}%0A+                                                                 className="rounded-lg border border-slate-200 px-2 py-1 font-mono text-[10px] text-blue-600 hover:bg-blue-50 dark:border-slate-700 dark:text-blue-300"%0A+                                                             >%0A+                                                                 View page {pageNumber}%0A+                                                             </button>%0A+                                                         )}%0A+                                                         <span className={`rounded-full px-2 py-1 font-mono text-[9px] uppercase tracking-wider ${included%0A+                                                             ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300'%0A+                                                             : 'bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400'%0A+                                                         }`}>%0A+                                                             {included ? 'Included' : 'Excluded'}%0A+                                                         </span>%0A+                                                     </div>%0A+                                                 </div>%0A+%0A+                                                 <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">%0A+                                                     <label className="sm:col-span-2">%0A+                                                         <span className={labelClass}>Test name</span>%0A+                                                         <input%0A+                                                             value={result.testName}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { testName: event.target.value },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>LOINC</span>%0A+                                                         <input%0A+                                                             value={result.loincCode || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { loincCode: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Status</span>%0A+                                                         <select%0A+                                                             value={result.status || 'unknown'}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 {%0A+                                                                     status: event.target.value as ReviewedObservationDraft['status'],%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         >%0A+                                                             {RESULT_STATUSES.map(status => (%0A+                                                                 <option key={status} value={status}>%0A+                                                                     {fieldLabel(status)}%0A+                                                                 </option>%0A+                                                             ))}%0A+                                                         </select>%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Value</span>%0A+                                                         <input%0A+                                                             value={result.valueText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { valueText: nullableText(event.target.value) },%0A+                                                             )}%0A+                                                             placeholder="5.7, <5, Negative, text…"%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Unit</span>%0A+                                                         <input%0A+                                                             value={result.unitText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { unitText: nullableText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Reference range</span>%0A+                                                         <input%0A+                                                             value={result.referenceRangeText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 {%0A+                                                                     referenceRangeText: nullableText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Interpretation flag</span>%0A+                                                         <input%0A+                                                             value={result.interpretationText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 {%0A+                                                                     interpretationText: nullableText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             placeholder="High, low, abnormal…"%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label className="sm:col-span-2">%0A+                                                         <span className={labelClass}>Absent-result reason</span>%0A+                                                         <input%0A+                                                             value={result.absentReasonText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 {%0A+                                                                     absentReasonText: nullableText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             placeholder="Use when no result value exists"%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Clinical date</span>%0A+                                                         <input%0A+                                                             value={result.clinicalDate || ''}%0A+                                                             onChange={event => updateResult(%0