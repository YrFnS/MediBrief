                                              result.localId,%0A+                                                                 {%0A+                                                                     specimenLocalId: optionalText(event.target.value),%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         >%0A+                                                             <option value="">Not linked</option>%0A+                                                             {(draft.specimens || []).map(specimen => (%0A+                                                                 <option%0A+                                                                     key={specimen.localId}%0A+                                                                     value={specimen.localId}%0A+                                                                 >%0A+                                                                     {specimen.typeText || specimen.localId}%0A+                                                                 </option>%0A+                                                             ))}%0A+                                                         </select>%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Source page</span>%0A+                                                         <input%0A+                                                             type="number"%0A+                                                             min="1"%0A+                                                             value={result.source?.pageNumber || ''}%0A+                                                             onChange={event => updateResultSource(%0A+                                                                 result.localId,%0A+                                                                 {%0A+                                                                     pageNumber: Number(event.target.value) > 0%0A+                                                                         ? Number(event.target.value)%0A+                                                                         : undefined,%0A+                                                                 },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Section</span>%0A+                                                         <input%0A+                                                             value={result.source?.section || ''}%0A+                                                             onChange={event => updateResultSource(%0A+                                                                 result.localId,%0A+                                                                 { section: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Method</span>%0A+                                                         <input%0A+                                                             value={result.methodText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { methodText: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label>%0A+                                                         <span className={labelClass}>Body site</span>%0A+                                                         <input%0A+                                                             value={result.bodySiteText || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { bodySiteText: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label className="sm:col-span-2 lg:col-span-4">%0A+                                                         <span className={labelClass}>Source excerpt</span>%0A+                                                         <textarea%0A+                                                             value={result.source?.excerpt || ''}%0A+                                                             onChange={event => updateResultSource(%0A+                                                                 result.localId,%0A+                                                                 { excerpt: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             rows={2}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                     <label className="sm:col-span-2 lg:col-span-4">%0A+                                                         <span className={labelClass}>Notes</span>%0A+                                                         <input%0A+                                                             value={result.note || ''}%0A+                                                             onChange={event => updateResult(%0A+                                                                 result.localId,%0A+                                                                 { note: optionalText(event.target.value) },%0A+                                                             )}%0A+                                                             className={inputClass}%0A+                                                         />%0A+                                                     </label>%0A+                                                 </div>%0A+                                             </article>%0A+                                         );%0A+                                     })}%0A+                                 </div>%0A+                             </section>%0A+%0A+%0A+                             {conflictCandidates.length > 0 && (%0A+                                 <section className="rounded-2xl border border-violet-200 bg-violet-50 p-4 dark:border-violet-900/50 dark:bg-violet-950/20">%0A+                                     <div className="flex items-start gap-3">%0A+                                         <AlertTriangleIcon className="mt-0.5 h-5 w-5 flex-shrink-0 text-violet-600 dark:text-violet-300" />%0A+                                         <div className="min-w-0 flex-1">%0A+                                             <h3 className="text-sm font-bold text-violet-950 dark:text-violet-100">%0A+                                                 Potential duplicate or corrected report%0A+                                             </h3>%0A+                                             <p className="mt-1 text-xs leading-relaxed text-violet-800 dark:text-violet-200">%0A+                                                 Blocking matches require an explicit reviewed decision. A corrected or amended report creates a new version and preserves every prior report and result.%0A+                                             </p>%0A+                                         </div>%0A+                                     </div>%0A+%0A+                                     <div className="mt-3 space-y-2">%0A+                                         {conflictCandidates.map(candidate => (%0A+                                             <article%0A+                                                 key={candidate.reportId}%0A+                                                 className={`rounded-xl border p-3 ${candidate.blocking%0A+                                                     ? 'border-red-200 bg-white dark:border-red-900/60 dark:bg-slate-950/60'%0A+                                                     : 'border-violet-200 bg-white dark:border-violet-900/50 dark:bg-slate-950/60'%0A+                                                 }`}%0A+                                             >%0A+                                                 <div className="flex flex-wrap items-center gap-2">%0A+                                                     <span className="text-xs font-bold text-slate-900 dark:text-white">%0A+                                                         {candidate.reportTitle}%0A+                                                     </span>%0A+                                                     <span className="rounded-full bg-slate-100 px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-slate-600 dark:bg-slate-800 dark:text-slate-300">%0A+                                                         {fieldLabel(candidate.kind)}%0A+                                                     </span>%0A+                                                     <span className="rounded-full bg-slate-100 px-2 py-1 font-mono text-[9px] text-slate-500 dark:bg-slate-800">%0A+                                                         score {candidate.score}%0A+                                                     </span>%0A+                                                     {candidate.blocking && (%0A+                                                         <span className="rounded-full bg-red-100 px-2 py-1 font-mono text-[9px] uppercase tracking-wider text-red-700 dark:bg-red-950/40 dark:text-red-300">%0A+                                                             Decision required%0A+                                                         </span>%0A+                                                     )}%0A+                                                 </div>%0A+                                                 <p className="mt-1 text-[10px] text-slate-500 dark:text-slate-400">%0A+                                                     {candidate.clinicalDateLabel} · {candidate.sourceLabel} · report {candidate.reportId}%0A+                                                 </p>%0A+                                                 <ul className="mt-2 list-disc space-y-1 pl-5 text-[10px] text-slate-600 dark:text-slate-300">%0A+                                                     {candidate.evidence.map(item => (%0A+                                                         <li key={item}>{item}</li>%0A+                                                     ))}%0A+                                                 </ul>%0A+                                             </article>%0A+                                         ))}%0A+                                     </div>%0A+%0A+                                     <div className="mt-3 grid gap-3 sm:grid-cols-2">%0A+                                         <label>%0A+                                             <span className={labelClass}>Related existing report</span>%0A+                                             <select%0A+                                                 value={relatedReportId}%0A+                                                 onChange={event => setRelatedReportId(event.target.value)}%0A+                                                 className={inputClass}%0A+                                             >%0A+                                                 <option value="">Select a report</option>%0A+                                                 {conflictCandidates.map(candidate => (%0A+                                                     <option key={candidate.reportId} value={candidate.reportId}>%0A+                                                         {candidate.reportTitle} · {fieldLabel(candidate.kind)}%0A+                                                     </option>%0A+                                                 ))}%0A+                                             </select>%0A+                                         </label>%0A+                                         <label>%0A+                                             <span className={labelClass}>Reviewed decision</span>%0A+                                             <select%0A+                                                 value={conflictDecision}%0A+                                                 onChange={event => {%0A+                                                     const decision = event.target.value as DiagnosticConflictDecision | '';%0A+                                                     setConflictDecision(decision);%0A+                                                     if (decision === 'corrects') {%0A+                                                         setReportField('status', 'corrected');%0A+                                                     } else if (decision === 'amends') {%0A+                                                         setReportField('status', 'amended');%0A+                                                     } else if (decision === 'replaces' && ![%0A+                                                         'final',%0A+                                                         'amended',%0A+                                                         'corrected',%0A+                                                     ].includes(draft.status || '')) {%0A+                                                         setReportField('status', 'final');%0A+                                                     }%0A+                                                 }}%0A+                                                 className={inputClass}%0A+                                             >%0A+                                                 <option value="">Select a decision</option>%0A+                                                 <option value="duplicate">Duplicate — do not save another copy</option>%0A+                                                 <option value="corrects">Corrects the selected report</option>%0A+                                                 <option value="amends">Amends the selected report</option>%0A+                                                 <option value="replaces">Replaces the selected 