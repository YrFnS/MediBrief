                    </div>%0A+                                     <div className="rounded-xl bg-slate-100 p-3 dark:bg-slate-800">%0A+                                         <p className="text-[10px] uppercase tracking-wider text-slate-400">Excluded</p>%0A+                                         <p className="mt-1 text-xl font-bold">{Math.max(0, excludedCount)}</p>%0A+                                     </div>%0A+                                     <div className="rounded-xl bg-slate-100 p-3 dark:bg-slate-800">%0A+                                         <p className="text-[10px] uppercase tracking-wider text-slate-400">Edits</p>%0A+                                         <p className="mt-1 text-xl font-bold">%0A+                                             {(evidence?.reportChanges?.length || 0)%0A+                                                 + resultChangeCount%0A+                                                 + specimenChangeCount}%0A+                                         </p>%0A+                                     </div>%0A+                                     <div className="rounded-xl bg-slate-100 p-3 dark:bg-slate-800">%0A+                                         <p className="text-[10px] uppercase tracking-wider text-slate-400">Graph</p>%0A+                                         <p className={`mt-1 text-sm font-bold ${prepared.value?.validation.valid%0A+                                             ? 'text-emerald-600'%0A+                                             : 'text-red-600'%0A+                                         }`}>%0A+                                             {prepared.value?.validation.valid%0A+                                                 ? 'Ready'%0A+                                                 : 'Blocked'}%0A+                                         </p>%0A+                                     </div>%0A+                                 </div>%0A+%0A+                                 <label className="mt-3 block">%